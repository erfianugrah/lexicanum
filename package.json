{
  "name": "lexicanum",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "bun test tests --bail && astro build && bun run verify:docs",
    "preview": "wrangler dev",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "verify:docs": "CHECK_BUILT=1 bun test tests",
    "verify:docs:links": "CHECK_LINKS=1 bun test tests/links.test.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/react": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.7",
    "@beoe/cache": "^0.1.1",
    "@beoe/rehype-graphviz": "^0.4.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "7.2.0",
    "katex": "^0.16.27",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rehype-katex": "^7.0.1",
    "remark-d2": "^0.2.3",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.0",
    "yaml": "^2.9.0"
  },
  "patchedDependencies": {
    "remark-d2@0.2.3": "patches/remark-d2@0.2.3.patch"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "wrangler": "^4.118.0"
  }
}
