{
  "name": "lexicanum",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "tsc --noEmit && bun test tests --bail && astro build && bun run verify:docs",
    "preview": "wrangler dev",
    "astro": "astro",
    "deploy": "wrangler deploy && bun scripts/purge-cache.ts",
    "verify:docs": "CHECK_BUILT=1 bun test tests",
    "verify:docs:links": "CHECK_LINKS=1 bun test tests/links.test.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "new": "bun scripts/new-doc.ts",
    "rentry": "bun scripts/rentry-export.ts",
    "check:tells": "bun scripts/tell-review.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/react": "7.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.6",
    "@beoe/cache": "^0.1.1",
    "@beoe/rehype-graphviz": "^0.4.2",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@hpcc-js/wasm": "^2.36.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "7.4.7",
    "katex": "^0.18.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "satori": "^0.33.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "better-sqlite3": "13.0.3",
    "fflate": "0.7.5",
    "nanoid": "3.3.18",
    "picomatch": "2.3.2",
    "postcss": "8.5.33",
    "postcss-selector-parser": "6.1.5",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2",
    "svgo": "3.3.5",
    "undici": "8.13.1",
    "zod": "4.6.6",
    "js-yaml": "^4.3.2",
    "katex": "^0.18.11"
  }
}
