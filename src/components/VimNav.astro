---
{/* Vim-style keyboard navigation, site-wide.
    Keys: j/k scroll, gg/G top/bottom, / opens search, Esc blurs.
    All handlers bail when focus is in a form field or a modifier key
    is held, so typing and browser shortcuts are unaffected. */}
---

<script>
  const STEP = 80;
  const GG_WINDOW_MS = 500;
  let pendingG = 0;

  function typing(): boolean {
    const el = document.activeElement;
    if (!el) return false;
    const tag = el.tagName;
    return (
      tag === 'INPUT' ||
      tag === 'TEXTAREA' ||
      tag === 'SELECT' ||
      (el as HTMLElement).isContentEditable
    );
  }

  window.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;

    if (e.key === 'Escape') {
      (document.activeElement as HTMLElement | null)?.blur?.();
      return;
    }

    if (typing()) return;

    switch (e.key) {
      case 'j':
        window.scrollBy(0, STEP);
        break;
      case 'k':
        window.scrollBy(0, -STEP);
        break;
      case 'g': {
        const now = Date.now();
        if (now - pendingG < GG_WINDOW_MS) {
          window.scrollTo(0, 0);
          pendingG = 0;
        } else {
          pendingG = now;
        }
        break;
      }
      case 'G':
        window.scrollTo(0, document.documentElement.scrollHeight);
        break;
      case '/': {
        const btn = document.querySelector<HTMLButtonElement>(
          'button[data-open-modal]',
        );
        if (btn) {
          e.preventDefault();
          btn.click();
        }
        break;
      }
    }
  });
</script>
