---
// house frame: the site's name as the house app mark (Overpass Mono bold
// caps), no logo image. Overrides Starlight's SiteTitle.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title house-home">
	<span class="house-app" translate="no">{siteTitle}</span>
</a>

<style>
	.site-title {
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
	}
</style>
