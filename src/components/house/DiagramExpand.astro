---
// Click-to-expand for diagrams the content column shrinks. A diagram figure
// (figure.beoe, the @beoe/rehype-graphviz output) whose SVG renders smaller
// than its intrinsic size (width/height attributes, else the viewBox) gets
// an EXPAND DIAGRAM button and a zoom-in cursor; either opens a lightbox
// (modal <dialog> over the dimmed page) with a copy of the figure at
// intrinsic size, panned by scrolling or (mouse) dragging. Escape, the
// close button or a click on the backdrop closes it. Script only, so it can
// sit in a Head override: a <dialog> element in <head> would end the head
// early.
---

<script>
	const figures = document.querySelectorAll<HTMLElement>('.sl-markdown-content figure.beoe');
	if (figures.length > 0) {
		const dialog = document.createElement('dialog');
		dialog.className = 'house-diagram-dialog';
		dialog.setAttribute('aria-label', 'Diagram');
		const bar = document.createElement('div');
		bar.className = 'house-diagram-bar';
		const close = document.createElement('button');
		close.type = 'button';
		close.className = 'house-icon-btn';
		close.setAttribute('aria-label', 'Close diagram');
		close.innerHTML =
			'<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5"/></svg>';
		close.addEventListener('click', () => dialog.close());
		bar.append(close);
		const body = document.createElement('div');
		body.className = 'house-diagram-body';
		dialog.append(bar, body);
		dialog.addEventListener('close', () => body.replaceChildren());
		// The dialog has no padding, so a click whose target is the dialog
		// itself landed on the backdrop.
		dialog.addEventListener('click', (ev) => {
			if (ev.target === dialog) dialog.close();
		});
		// Mouse drag pans; touch and pen keep native scrolling and pinch zoom.
		body.addEventListener('pointerdown', (ev) => {
			if (ev.pointerType !== 'mouse' || ev.button !== 0) return;
			const x = ev.clientX + body.scrollLeft;
			const y = ev.clientY + body.scrollTop;
			body.setPointerCapture(ev.pointerId);
			body.setAttribute('data-dragging', '');
			const move = (m: PointerEvent) => body.scrollTo(x - m.clientX, y - m.clientY);
			const up = () => {
				body.removeAttribute('data-dragging');
				body.removeEventListener('pointermove', move);
			};
			body.addEventListener('pointermove', move);
			body.addEventListener('pointerup', up, { once: true });
			body.addEventListener('pointercancel', up, { once: true });
		});
		document.body.append(dialog);

		const open = (fig: HTMLElement) => {
			const copy = fig.cloneNode(true) as HTMLElement;
			copy.querySelector('.house-diagram-expand')?.remove();
			copy.removeAttribute('data-house-shrunk');
			copy.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
			body.replaceChildren(copy);
			dialog.showModal();
			body.scrollTo(0, 0);
		};

		// Shrunk = rendered more than 1px under the intrinsic size on either
		// axis (column width, or the site's max-height cap).
		const measure = (fig: HTMLElement) => {
			const svg = fig.querySelector('svg');
			if (!svg) return;
			const vb = svg.viewBox.baseVal;
			const w = Number(svg.getAttribute('width')) || vb?.width || 0;
			const h = Number(svg.getAttribute('height')) || vb?.height || 0;
			const r = svg.getBoundingClientRect();
			fig.toggleAttribute('data-house-shrunk', r.width < w - 1 || r.height < h - 1);
		};
		const ro = new ResizeObserver((entries) => entries.forEach((e) => measure(e.target as HTMLElement)));

		figures.forEach((fig) => {
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'house-diagram-expand';
			btn.textContent = 'Expand diagram';
			btn.addEventListener('click', () => open(fig));
			fig.append(btn);
			fig.addEventListener('click', (ev) => {
				if (!fig.hasAttribute('data-house-shrunk')) return;
				if ((ev.target as Element).closest('a, button')) return;
				open(fig);
			});
			ro.observe(fig);
		});
	}
</script>
