---
// Zoom in place for diagrams the content column shrinks. A diagram figure
// (figure.beoe, the @beoe/rehype-graphviz output) whose SVG renders smaller
// than its intrinsic size (width/height attributes, else the viewBox) is
// marked data-house-shrunk and gets a zoom-in cursor and a ZOOM button.
// Zooming keeps the figure where it is in the page and turns it into a
// scroll box with the diagram at intrinsic size:
//   click            zoom to intrinsic size, the clicked point kept under
//                    the pointer; click again (no drag) or Escape: fit
//   mouse drag       pan; touch and trackpad pan by native scrolling
//   ctrl+wheel       zoom between fit and 2x intrinsic at the cursor (a
//                    trackpad pinch arrives as ctrl+wheel); a plain wheel
//                    is never taken, so the page scroll is never trapped
//   ZOOM / FIT       the same toggle for keyboard and touch
// Zoom sets the svg's layout size, not a transform, so the vector redraws
// sharp at every level. Script only, so it can sit in a Head override.
---

<script>
	const MAX = 2; // x intrinsic
	// One 100px mouse-wheel notch zooms 1.15x; a trackpad pinch sends
	// -100 * ln(scale) per event, so 0.01/px follows the fingers.
	const WHEEL_PER_PX = Math.log(1.15) / 100;
	const PINCH_PER_PX = 0.01;

	// scale: current zoom (x intrinsic, 0 = fit); fit: the fit scale, measured
	// when zoom starts (the svg no longer shows it while zoomed).
	type Diagram = { fig: HTMLElement; svg: SVGSVGElement; btn: HTMLButtonElement; w: number; h: number; scale: number; fit: number };
	const diagrams: Diagram[] = [];

	const fitScale = (d: Diagram) => d.svg.getBoundingClientRect().width / d.w;

	const updateButton = (d: Diagram) => {
		const zoomed = d.fig.hasAttribute('data-house-zoomed');
		d.btn.textContent = zoomed ? 'Fit' : 'Zoom';
		d.btn.setAttribute('aria-pressed', String(zoomed));
	};

	const fit = (d: Diagram) => {
		d.fig.removeAttribute('data-house-zoomed');
		d.svg.style.width = '';
		d.svg.style.height = '';
		d.scale = 0;
		updateButton(d);
	};

	// Set the svg to `scale` x intrinsic, keeping the svg point under
	// (cx, cy) in the viewport there. Without a point, start at the left.
	const zoomTo = (d: Diagram, scale: number, cx?: number, cy?: number) => {
		const before = d.svg.getBoundingClientRect();
		if (!d.fig.hasAttribute('data-house-zoomed')) d.fit = before.width / d.w;
		const fx = cx === undefined ? 0 : (cx - before.left) / before.width;
		const fy = cy === undefined ? 0.5 : (cy - before.top) / before.height;
		d.scale = scale;
		d.fig.setAttribute('data-house-zoomed', '');
		d.svg.style.width = `${d.w * scale}px`;
		d.svg.style.height = `${d.h * scale}px`;
		const after = d.svg.getBoundingClientRect();
		if (cx === undefined) {
			d.fig.scrollLeft = 0;
			d.fig.scrollTop += after.top + fy * after.height - (d.fig.getBoundingClientRect().top + d.fig.clientHeight / 2);
		} else {
			d.fig.scrollLeft += after.left + fx * after.width - cx;
			d.fig.scrollTop += after.top + fy * after.height - (cy as number);
			// What the box cannot scroll (a short diagram grows the page),
			// the page scroll takes up, so the point stays under the pointer.
			const r = d.svg.getBoundingClientRect();
			window.scrollBy(0, r.top + fy * r.height - (cy as number));
		}
		updateButton(d);
	};

	// Shrunk = rendered more than 1px under intrinsic size on either axis.
	const measure = (d: Diagram) => {
		if (d.fig.hasAttribute('data-house-zoomed')) return;
		const r = d.svg.getBoundingClientRect();
		d.fig.toggleAttribute('data-house-shrunk', r.width < d.w - 1 || r.height < d.h - 1);
	};
	const ro = new ResizeObserver((entries) =>
		entries.forEach((e) => {
			const d = diagrams.find((x) => x.fig === e.target);
			if (d) measure(d);
		}),
	);

	document.querySelectorAll<HTMLElement>('.sl-markdown-content figure.beoe').forEach((fig) => {
		const svg = fig.querySelector('svg');
		if (!svg) return;
		const vb = svg.viewBox.baseVal;
		const w = Number(svg.getAttribute('width')) || vb?.width || 0;
		const h = Number(svg.getAttribute('height')) || vb?.height || 0;
		if (!w || !h) return;
		const btn = document.createElement('button');
		btn.type = 'button';
		btn.className = 'house-diagram-zoom';
		fig.after(btn);
		const d: Diagram = { fig, svg, btn, w, h, scale: 0, fit: 0 };
		diagrams.push(d);
		updateButton(d);

		btn.addEventListener('click', () => (fig.hasAttribute('data-house-zoomed') ? fit(d) : zoomTo(d, 1)));

		// Mouse drag pans; a press that moves more than 4px is a drag, and
		// the click that follows it is swallowed.
		let dragged = false;
		fig.addEventListener('pointerdown', (ev) => {
			dragged = false;
			if (ev.pointerType !== 'mouse' || ev.button !== 0) return;
			if (!fig.hasAttribute('data-house-zoomed')) return;
			const x0 = ev.clientX;
			const y0 = ev.clientY;
			const sl = fig.scrollLeft;
			const st = fig.scrollTop;
			const move = (m: PointerEvent) => {
				if (!dragged && Math.hypot(m.clientX - x0, m.clientY - y0) < 4) return;
				if (!dragged) {
					dragged = true;
					fig.setPointerCapture(ev.pointerId);
					fig.setAttribute('data-dragging', '');
				}
				fig.scrollLeft = sl - (m.clientX - x0);
				fig.scrollTop = st - (m.clientY - y0);
			};
			const up = () => {
				fig.removeAttribute('data-dragging');
				fig.removeEventListener('pointermove', move);
			};
			fig.addEventListener('pointermove', move);
			fig.addEventListener('pointerup', up, { once: true });
			fig.addEventListener('pointercancel', up, { once: true });
		});

		fig.addEventListener('click', (ev) => {
			if (dragged) return;
			if ((ev.target as Element).closest('a')) return;
			if (fig.hasAttribute('data-house-zoomed')) fit(d);
			else if (fig.hasAttribute('data-house-shrunk')) zoomTo(d, 1, ev.clientX, ev.clientY);
		});

		fig.addEventListener(
			'wheel',
			(ev) => {
				if (!ev.ctrlKey) return;
				if (!fig.hasAttribute('data-house-shrunk') && !fig.hasAttribute('data-house-zoomed')) return;
				ev.preventDefault();
				const base = d.scale || fitScale(d);
				const px = ev.deltaMode === 1 ? ev.deltaY * 16 : ev.deltaY;
				// simplify: a pinch and a ctrl+mouse wheel both arrive with ctrlKey; told
				// apart by step size (pinch steps are a few px, a notch ~100px).
				const next = Math.min(MAX, base * Math.exp(-px * (Math.abs(px) < 50 ? PINCH_PER_PX : WHEEL_PER_PX)));
				if (fig.hasAttribute('data-house-zoomed')) {
					if (next <= d.fit) return fit(d); // back to fit size
				} else if (next <= base) return;
				zoomTo(d, next, ev.clientX, ev.clientY);
			},
			{ passive: false },
		);

		ro.observe(fig);
	});

	if (diagrams.length > 0) {
		document.addEventListener('keydown', (ev) => {
			if (ev.key !== 'Escape') return;
			diagrams.forEach((d) => d.fig.hasAttribute('data-house-zoomed') && fit(d));
		});
	}
</script>
