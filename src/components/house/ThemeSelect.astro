---
// house theme toggle (revista dot-to-sun, two states) in place of
// Starlight's dark/light/auto select. Shares Starlight's storage key, so
// ThemeProvider still sets data-theme before paint; no stored pick follows
// the system scheme, as before.
---

<house-theme-toggle>
	<button
		type="button"
		class="house-icon-btn house-theme"
		data-theme-state="light"
		aria-label="Theme: light. Switch to dark theme"
		title="Switch to dark theme"
	>
		<svg
			viewBox="0 0 24 24"
			width="24"
			height="24"
			fill="none"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle class="house-theme-core" cx="12" cy="12" r="9" fill="currentColor"></circle>
			<g class="house-theme-rays" stroke="currentColor">
				<line x1="12" y1="1" x2="12" y2="3"></line>
				<line x1="12" y1="21" x2="12" y2="23"></line>
				<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
				<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
				<line x1="1" y1="12" x2="3" y2="12"></line>
				<line x1="21" y1="12" x2="23" y2="12"></line>
				<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
				<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
			</g>
		</svg>
	</button>
</house-theme-toggle>

{/* Inline so the icon matches the theme on first paint. */}
<script is:inline>
	(() => {
		const dark = document.documentElement.dataset.theme === 'dark';
		document.querySelectorAll('house-theme-toggle button').forEach((b) => {
			b.dataset.themeState = dark ? 'dark' : 'light';
			b.querySelector('circle')?.setAttribute('r', dark ? '5' : '9');
			b.setAttribute('aria-label', dark ? 'Theme: dark. Switch to light theme' : 'Theme: light. Switch to dark theme');
			b.title = dark ? 'Switch to light theme' : 'Switch to dark theme';
		});
	})();
</script>

<script>
	const storageKey = 'starlight-theme';

	function paint(mode: 'light' | 'dark') {
		document.querySelectorAll<HTMLButtonElement>('house-theme-toggle button').forEach((b) => {
			const dark = mode === 'dark';
			b.dataset.themeState = mode;
			b.querySelector('circle')?.setAttribute('r', dark ? '5' : '9');
			b.setAttribute('aria-label', dark ? 'Theme: dark. Switch to light theme' : 'Theme: light. Switch to dark theme');
			b.title = dark ? 'Switch to light theme' : 'Switch to dark theme';
		});
	}

	function apply(mode: 'light' | 'dark', store: boolean) {
		document.documentElement.dataset.theme = mode;
		if (store) {
			try {
				localStorage.setItem(storageKey, mode);
			} catch {
				// Storage blocked: the attribute still applies to this page.
			}
		}
		paint(mode);
	}

	const system = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		let stored: string | null = null;
		try {
			stored = localStorage.getItem(storageKey);
		} catch {}
		if (!stored) apply(system(), false);
	});

	class HouseThemeToggle extends HTMLElement {
		connectedCallback() {
			this.querySelector('button')?.addEventListener('click', () => {
				apply(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark', true);
			});
		}
	}
	if (!customElements.get('house-theme-toggle')) customElements.define('house-theme-toggle', HouseThemeToggle);
</script>
