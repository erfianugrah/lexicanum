---
/**
 * Starlight sidebar with per-category hue wayfinding. Each top-level <li>
 * gets data-hue=<N> (1-based index into the house hue palette), so CSS maps
 * [data-hue="N"] { --cat: var(--house-hue-N) }.
 *
 * Labels derive from CATEGORIES (src/house.categories.mjs), the site's
 * re-export of its taxonomy.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { CATEGORIES } from '../../house.categories.mjs';

const byLabel = Object.fromEntries(CATEGORIES.map((c, i) => [c.label, (i % 9) + 1]));
---

<Default><slot /></Default>
<script is:inline define:vars={{ byLabel }}>
	document.querySelectorAll('ul.top-level > li').forEach((li) => {
		const label = li.querySelector(':scope > details > summary .group-label')?.textContent?.trim();
		if (label && byLabel[label]) li.dataset.hue = byLabel[label];
	});
</script>