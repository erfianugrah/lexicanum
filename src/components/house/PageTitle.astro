---
/**
 * Page title with a category kicker above: "DATABASES / OPERATIONS / GUIDE".
 * data-hue carries the category's 1-based index into the house hue palette
 * (--house-hue-1 through --house-hue-9, wrapping). Kind is derived from the entry
 * id prefix: "guides/" -> guide, "reference/" -> reference.
 */
import { CATEGORIES } from '../../house.categories.mjs';

const PAGE_TITLE_ID = '_top';
const { entry } = Astro.locals.starlightRoute;
const data = entry.data as { title: string; category?: string; group?: string };
const cat = CATEGORIES.find((c: { id: string }) => c.id === data.category);
const hueIdx = cat ? (CATEGORIES.indexOf(cat) % 9) + 1 : 0;
const group = (cat as any)?.groups?.find((g: { id: string }) => g.id === data.group);
const kind = entry.id.startsWith('guides/') ? 'guide' : entry.id.startsWith('reference/') ? 'reference' : '';
---

{
	cat && (
		<p class="house-kicker" data-hue={hueIdx}>
			<span class="house-kicker-cat">{cat.label}</span>
			{group && <span>{group.label}</span>}
			{kind && <span class={`house-kind house-kind-${kind}`}>{kind}</span>}
		</p>
	)
}
<h1 id={PAGE_TITLE_ID}>{data.title}</h1>