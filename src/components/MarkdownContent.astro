---
/**
 * Starlight MarkdownContent override: the page body, then a "Linked from"
 * list of every doc that links here (src/lib/links.mjs). Rendered inside
 * .sl-markdown-content so it inherits the body typography. Pages nothing
 * links to get no section, and the homepage is not a doc so it gets none.
 */
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { getCollection } from 'astro:content';
import { backlinks } from '../lib/links.mjs';

// One scan per build; dev rescans per request so prose edits show up.
let cached: ReturnType<typeof backlinks> | undefined;
async function linkMap() {
	if (cached && !import.meta.env.DEV) return cached;
	cached = backlinks(await getCollection('docs'));
	return cached;
}

const { id } = Astro.locals.starlightRoute.entry;
const sources = (await linkMap()).get(id) ?? [];
---

<Default>
	<slot />
	{
		sources.length > 0 && (
			<section class="backlinks" aria-labelledby="linked-from">
				<h2 id="linked-from">Linked from</h2>
				<ul>
					{sources.map((s) => (
						<li>
							<a href={`/${s.id}/`}>{s.title}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Default>
