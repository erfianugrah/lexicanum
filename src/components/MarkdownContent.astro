---
/**
 * Starlight MarkdownContent override: the page body, then
 * - "Linked from": every doc that links here, and
 * - a collapsed neighbourhood graph: docs linking in, the page, docs it
 *   links to, rendered to inline SVG at build time (@hpcc-js/wasm, the same
 *   Graphviz build the dot fences use; no client JS).
 * Both come from src/lib/links.mjs. Rendered inside .sl-markdown-content so
 * they inherit the body typography. The homepage is not a doc and gets
 * neither. The list is the text fallback for the graph's inbound half; the
 * outbound half is the links in the page itself.
 */
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { getCollection } from 'astro:content';
import { Graphviz } from '@hpcc-js/wasm/graphviz';
import { backlinks, neighbourhoodDot, outlinks } from '../lib/links.mjs';

// One scan per build; dev rescans per request so prose edits show up.
let cached: { inbound: ReturnType<typeof backlinks>; outbound: ReturnType<typeof outlinks> } | undefined;
async function linkMaps() {
	if (cached && !import.meta.env.DEV) return cached;
	const entries = await getCollection('docs');
	cached = { inbound: backlinks(entries), outbound: outlinks(entries) };
	return cached;
}
let graphviz: ReturnType<typeof Graphviz.load> | undefined;

const { id, data } = Astro.locals.starlightRoute.entry;
const { inbound, outbound } = await linkMaps();
const sources = inbound.get(id) ?? [];
const targets = outbound.get(id) ?? [];
const dot = /^(guides|reference)\//.test(id) ? neighbourhoodDot({ id, title: data.title }, sources, targets) : undefined;
// Graphviz prepends an XML prolog, doctype and comments; keep the <svg> only.
const svg = dot ? (await (graphviz ??= Graphviz.load())).dot(dot).replace(/^[\s\S]*?(?=<svg)/, '') : undefined;
---

<Default>
	<slot />
	{
		sources.length > 0 && (
			<section class="backlinks" aria-labelledby="linked-from" data-pagefind-ignore>
				<h2 id="linked-from">Linked from</h2>
				<ul>
					{sources.map((s) => (
						<li>
							<a href={`/${s.id}/`}>{s.title}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
	{
		svg && (
			<details class="link-graph not-content" data-pagefind-ignore>
				<summary>
					Link graph: {sources.length} {sources.length === 1 ? 'doc links' : 'docs link'} here, this
					page links to {targets.length}
				</summary>
				<figure set:html={svg} />
			</details>
		)
	}
</Default>
