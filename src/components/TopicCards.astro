---
/**
 * Homepage discovery hub: one section per taxonomy category, with a CardGrid
 * of the docs that carry `featured: true` in frontmatter (the curated entry
 * points), then a collapsed full listing of every doc in the category - the
 * sidebar's completeness without leaving the homepage. Curated by flag, not
 * by hand-editing this page - adding a doc to the homepage is a frontmatter
 * change on the doc.
 */
import { getCollection } from "astro:content";
import { CardGrid, LinkCard } from "@astrojs/starlight/components";
import { TAXONOMY } from "../lib/taxonomy.mjs";

// Guides first, matching the sidebar sort.
const guidesFirst = (a, b) => {
  const at = a.id.startsWith("guides/") ? 0 : 1;
  const bt = b.id.startsWith("guides/") ? 0 : 1;
  return at - bt || a.data.title.localeCompare(b.data.title);
};

const live = await getCollection("docs", ({ data }) => !data.draft);
const byCategory = new Map(
  TAXONOMY.map((c) => [c.id, live.filter((d) => d.data.category === c.id).sort(guidesFirst)]),
);
---

{
  TAXONOMY.map((category) => {
    const docs = byCategory.get(category.id) ?? [];
    const featured = docs.filter((d) => d.data.featured === true);
    if (docs.length === 0) return null;
    return (
      <>
        <h2>{category.label}</h2>
        <p>{category.blurb}</p>
        {featured.length > 0 && (
          <CardGrid>
            {featured.map((doc) => (
              <LinkCard
                title={doc.data.title}
                href={`/${doc.id}/`}
                description={doc.data.blurb ?? doc.data.description}
              />
            ))}
          </CardGrid>
        )}
        <details>
          <summary>
            All {category.label} docs ({docs.length})
          </summary>
          <ul>
            {docs.map((doc) => (
              <li>
                <a href={`/${doc.id}/`}>{doc.data.title}</a>
                {doc.id.startsWith("reference/") && " (reference)"}
              </li>
            ))}
          </ul>
        </details>
      </>
    );
  })
}
